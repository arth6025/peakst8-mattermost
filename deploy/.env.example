# ── Required ─────────────────────────────────────────────
DOMAIN=mattermost.peakst8.club
# Let's Encrypt expiry notices go here.
ACME_EMAIL=
# The System Admin account setup.sh creates (a shared mailbox, not a person). Password is generated.
ADMIN_EMAIL=it@peakst8.club
# Only this email domain can sign up.
ALLOWED_DOMAIN=peakst8.club
# install.sh generates this if left blank.
POSTGRES_PASSWORD=

# ── Version ──────────────────────────────────────────────
# 11.11.1 = latest stable at 6 Oct 2026. Upgrade by changing this and running: docker compose up -d
MM_VERSION=11.11.1
TZ=Asia/Kolkata

# ── Outgoing mail (strongly recommended before inviting anyone) ──
# Without SMTP: no password resets, no missed-message emails, and @peakst8.club self sign-up stays
# closed (it needs email verification, or anyone could type a made-up address).
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURITY=STARTTLS
SMTP_AUTH=true
MAIL_FROM=
